{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "attemptId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "sourceDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "author": {
      "type": "string",
      "const": "tutor"
    },
    "createdAt": {
      "type": "string"
    },
    "criteria": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterionId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "state": {
            "type": "string",
            "enum": [
              "supported",
              "needs-work",
              "uncertain"
            ]
          },
          "excerpt": {
            "type": "string",
            "maxLength": 4000
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "criterionId",
          "state",
          "excerpt",
          "rationale"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "attemptId",
    "sourceDigest",
    "author",
    "createdAt",
    "criteria"
  ],
  "additionalProperties": false
}
