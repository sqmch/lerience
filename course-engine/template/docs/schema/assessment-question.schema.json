{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "moduleId": {
      "type": "string",
      "pattern": "^[0-9]{2}-[a-z0-9-]{1,80}$"
    },
    "questionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "fields": {
      "minItems": 2,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "integer",
              "explanation"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "units": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "id",
          "kind",
          "label",
          "units"
        ],
        "additionalProperties": false
      }
    },
    "criteria": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "id",
          "description"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "moduleId",
    "questionId",
    "version",
    "title",
    "prompt",
    "fields",
    "criteria"
  ],
  "additionalProperties": false
}
