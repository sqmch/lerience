{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "enum": [
        1
      ]
    },
    "courseId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "marks": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
          },
          "courseId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
          },
          "moduleId": {
            "type": "string",
            "pattern": "^[0-9]{2}-[a-z0-9-]{1,80}$"
          },
          "lessonPath": {
            "type": "string",
            "maxLength": 120
          },
          "sourceDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "extractionVersion": {
            "enum": [
              "marked18-prose-v1"
            ]
          },
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "heading": {
            "type": "string",
            "maxLength": 2000
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16000
          },
          "end": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16000
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "createdAt": {
            "type": "string",
            "maxLength": 40
          }
        },
        "required": [
          "id",
          "courseId",
          "moduleId",
          "lessonPath",
          "sourceDigest",
          "extractionVersion",
          "index",
          "heading",
          "text",
          "start",
          "end",
          "quote",
          "createdAt"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "courseId",
    "revision",
    "marks"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
